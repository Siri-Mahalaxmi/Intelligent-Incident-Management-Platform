# Supabase project URL (found in Project Settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service-role key (NOT the anon key — needed for server-side writes)
# NEVER expose this to the frontend
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Google Gemini API key (used by the Log Analysis Agent)
GEMINI_API_KEY=

# Supabase JWT secret — used to verify tokens sent by the frontend
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Optional: production frontend origin for CORS (e.g. https://iimp.yourdomain.com)
FRONTEND_ORIGIN=
